# Do not run dependency lifecycle scripts on install.
#
# Without this, npm runs an implicit `node-gyp rebuild` for better-sqlite3 (it ships a
# binding.gyp and no install script of its own), which tries to compile SQLite from source
# and fails on any Windows machine without Visual Studio C++ build tools. The compile is
# never needed: better-sqlite3 bundles prebuilt binaries for every platform this app targets,
# including win32-x64, and loads the right one at require time.
#
# One caveat: this also skips Playwright's browser download. Before running `npm run e2e`
# for the first time, run `npx playwright install chromium` once. Nothing in `npm run dev`
# or `npm test` needs a browser.
ignore-scripts=true
